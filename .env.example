# HoaxScope environment template.
# Copy this file to `.env` for local development. Never commit a real `.env`.
# Use placeholder credentials only; production values belong in a secret manager.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Local development example only. Replace credentials in any shared environment.
DATABASE_URL=postgresql+psycopg://hoaxscope:change-me@localhost:5432/hoaxscope

# Leave empty until a real model artifact has been trained and registered.
# The API must report that no model is available instead of substituting one.
ACTIVE_MODEL=
MODEL_ARTIFACT_DIR=./artifacts
DATA_DIR=./ml/data

# CORS origin for the dashboard.
FRONTEND_ORIGIN=http://localhost:3000
# Planned for the dashboard phase; not used by the current repository.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional. Only set when Redis is actually part of the deployment.
# REDIS_URL=redis://localhost:6379/0
