# ---------------------------------------------------------------------------
# HoaxScope .gitignore
# Keep secrets, raw data, and large artifacts out of Git.
# ---------------------------------------------------------------------------

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
coverage.xml
.coverage
.coverage.*
htmlcov/
*.egg-info/
.eggs/
build/
dist/
site/

# Jupyter
.ipynb_checkpoints/

# Node.js / Next.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
playwright-report/
test-results/
blob-report/

# Raw and generated data (directory markers are kept)
ml/data/raw/*
!ml/data/raw/.gitkeep
ml/data/interim/*
!ml/data/interim/.gitkeep
ml/data/processed/*
!ml/data/processed/.gitkeep

# Model artifacts and checkpoints
artifacts/*
!artifacts/.gitkeep
models/
*.joblib
*.pkl
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.safetensors
*.bin

# Logs and local reports
logs/
*.log

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
